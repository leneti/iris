[Unit]
Description=Write the host status file that Iris reads

[Service]
Type=oneshot
ExecStart=@NODE@ --disable-warning=ExperimentalWarning @EXPORTER@ --jobs-dir @JOBS_DIR@ --out /var/lib/media-status/status.json
# No NoNewPrivileges=yes: it drops the setgid bit that `crontab -l` needs to read the spool.
Nice=10
