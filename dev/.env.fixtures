# Placeholder values only: every address is a fixture server on 127.0.0.1 and every key is fake.
# Used by `yarn dev:fixtures`, which loads this file for `next dev`.
# Without IRIS_ALLOWED_HOSTS every request is answered 400.
IRIS_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
IRIS_ZONE=example.invalid

IRIS_DOCKER_URL=http://127.0.0.1:47480
IRIS_TRAEFIK_URL=http://127.0.0.1:47481
IRIS_CRON_STATUS_URL=http://127.0.0.1:47482/cron-status

IRIS_CONFIG_DIR=dev/config
IRIS_CACHE_DIR=.tmp/cache
# The host status file is ignored when its generatedAt is older than 15 minutes, so a committed
# file would soon read "stale". The fixture server writes this one when it starts and rewrites it
# every minute; .tmp/ is untracked.
IRIS_HOST_STATUS_FILE=.tmp/host-status/status.json
IRIS_ICONS_BASE=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@f1d048d9885b97a7319e0a51e508217459f212df

# Development only (ignored when NODE_ENV is production): Cloudflare, CoinMarketCap and
# Open-Meteo calls go to the fixture server instead.
IRIS_DEV_EXTERNAL_BASE=http://127.0.0.1:47481

IRIS_SEERR_KEY=fixture-key
IRIS_TAUTULLI_KEY=fixture-key
IRIS_RADARR_KEY=fixture-key
IRIS_SONARR_KEY=fixture-key
IRIS_PROWLARR_KEY=fixture-key
IRIS_AUTOBRR_KEY=fixture-key
IRIS_QBITTORRENT_USERNAME=fixture-user
IRIS_QBITTORRENT_PASSWORD=fixture-password
IRIS_CLOUDFLARE_ACCOUNT_ID=fixture-account
IRIS_CLOUDFLARE_TUNNEL_ID=fixture-tunnel
IRIS_CLOUDFLARE_TOKEN=fixture-token
IRIS_COINMARKETCAP_KEY=fixture-key
IRIS_GOTIFY_TOKEN=fixture-key
