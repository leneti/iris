# Placeholder values only: every address is a fixture server on 127.0.0.1 and every key is fake.
# Used by `yarn dev:fixtures`, which loads this file for `next dev`.
# Without DASHBOARD_ALLOWED_HOSTS every request is answered 400.
DASHBOARD_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
DASHBOARD_ZONE=example.invalid

DASHBOARD_DOCKER_URL=http://127.0.0.1:47480
DASHBOARD_TRAEFIK_URL=http://127.0.0.1:47481
DASHBOARD_CRON_STATUS_URL=http://127.0.0.1:47482/cron-status

DASHBOARD_CONFIG_DIR=dev/config
DASHBOARD_CACHE_DIR=.tmp/cache
# The host status file is ignored when its generatedAt is older than 15 minutes, so a committed
# file would soon read "stale". The fixture server writes this one when it starts and rewrites it
# every minute; .tmp/ is untracked.
DASHBOARD_HOST_STATUS_FILE=.tmp/host-status/status.json
DASHBOARD_ICONS_BASE=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@f1d048d9885b97a7319e0a51e508217459f212df

# Development only (ignored when NODE_ENV is production): Cloudflare, CoinMarketCap and
# Open-Meteo calls go to the fixture server instead.
DASHBOARD_DEV_EXTERNAL_BASE=http://127.0.0.1:47481

DASHBOARD_SEERR_KEY=fixture-key
DASHBOARD_TAUTULLI_KEY=fixture-key
DASHBOARD_RADARR_KEY=fixture-key
DASHBOARD_SONARR_KEY=fixture-key
DASHBOARD_PROWLARR_KEY=fixture-key
DASHBOARD_AUTOBRR_KEY=fixture-key
DASHBOARD_QBITTORRENT_USERNAME=fixture-user
DASHBOARD_QBITTORRENT_PASSWORD=fixture-password
DASHBOARD_CLOUDFLARE_ACCOUNT_ID=fixture-account
DASHBOARD_CLOUDFLARE_TUNNEL_ID=fixture-tunnel
DASHBOARD_CLOUDFLARE_TOKEN=fixture-token
DASHBOARD_COINMARKETCAP_KEY=fixture-key
DASHBOARD_GOTIFY_TOKEN=fixture-key
